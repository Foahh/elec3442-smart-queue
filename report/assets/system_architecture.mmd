flowchart LR
    subgraph EDGE["Edge Node (Raspberry Pi 5)"]
        CAM[PiCamera2 / Video file]
        SENSE[Sense HAT<br/>8x8 LED + sensors]
        subgraph APP["smart-queue process"]
            LOOP[Camera Loop]
            DET[YOLO26 NCNN<br/>+ ByteTrack]
            ZONE[Queue Zone<br/>Polygon Filter]
            TRACK[Queue State<br/>Tracker]
            EST[Wait Time<br/>Estimator]
            COMF[Comfort Score]
            DB[(SQLite<br/>queue.db)]
            PREV[MJPEG Preview<br/>HTTP Server]
            HUB[Hub Sync<br/>Agent]
        end
    end

    subgraph CLOUD["Cloudflare Workers"]
        API[Next.js API<br/>/ingest /sites /history]
        D1[(Cloudflare D1<br/>site_snapshots<br/>site_status)]
        WEB[Next.js SSR<br/>Dashboard]
    end

    USER[Browser user]

    CAM -->|frames| LOOP
    LOOP --> DET --> ZONE --> TRACK --> EST --> COMF
    TRACK -->|events| DB
    LOOP -->|snapshots| DB
    LOOP -->|annotated frames| PREV
    SENSE -->|T, RH, P| LOOP
    LOOP -->|level, queue| SENSE

    HUB -->|POST /api/ingest<br/>X-Api-Key| API
    API -->|GET /api/sites| HUB
    API --> D1
    WEB -->|SSR queries| API
    USER -->|browse| WEB
    USER -.->|local LAN| PREV
